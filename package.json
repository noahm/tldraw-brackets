{
	"name": "tldraw-brackets",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"build": "tsc && vite build",
		"typecheck": "tsc",
		"test": "vitest run",
		"check:btp": "vitest run --config vitest.drift.config.ts btp",
		"check:startgg": "vitest run --config vitest.drift.config.ts startgg",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"preview": "vite preview",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@tldraw/assets": "^5.5.0",
		"@tldraw/sync": "^5.5.0",
		"@tldraw/sync-core": "^5.5.0",
		"@tldraw/tlschema": "^5.5.0",
		"@tldraw/validate": "^5.5.0",
		"cloudflare-workers-unfurl": "^0.0.9",
		"itty-router": "^5.0.18",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"react-router-dom": "^6.28.2",
		"tldraw": "^5.5.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.29.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"concurrently": "^9.1.2",
		"prettier": "3.8.1",
		"typescript": "^5.8.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.3",
		"wrangler": "^4.75.0"
	}
}
